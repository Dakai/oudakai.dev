---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BlogRow from "../../components/BlogRow.astro";
import EmptyState from "../../components/EmptyState.astro";
import type { ComponentProps } from "astro/types";

// Content slot — add posts here, newest first.
const posts: ComponentProps<typeof BlogRow>[] = [];
---

<BaseLayout title="Blog — DAKAI">
  <section class="section">
    <div class="container">
      <SectionHeading
        index="02"
        label="WRITING"
        title="Notes on building."
        subtitle="Design, code and running a small studio. Newest first."
      />
      {
        posts.length > 0 ? (
          <div>{posts.map((p) => <BlogRow {...p} />)}</div>
        ) : (
          <EmptyState label="No articles published yet." />
        )
      }
    </div>
  </section>
</BaseLayout>
