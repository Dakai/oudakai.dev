---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="About — DAKAI">
  <section class="section">
    <div class="container">
      <p class="mono-label">04 / ABOUT</p>
      <h1 style="font-size:var(--text-h1);line-height:1;letter-spacing:-.035em;margin-top:12px;max-width:14ch">Independent studio for useful digital things.</h1>
      <div style="margin-top:32px;display:grid;grid-template-columns:1.2fr .8fr;gap:32px" class="about-grid">
        <div style="display:grid;gap:16px;color:var(--text-secondary);line-height:1.7">
          <p>I'm Dakai — designer, developer, and operator. I build websites, tools and experiments where design and engineering meet.</p>
          <p>The site is intentionally quiet: typography first, restrained color, oversized headings, mono details. No decoration without purpose — <em style="color:var(--text-primary)">70% editorial / 20% technical / 10% experimental</em>.</p>
          <p>Available for selected client work. If you have something useful to build, let's talk.</p>
          <p><a href="mailto:hello@oudakai.dev" class="btn btn--primary">Discuss a project →</a></p>
        </div>
        <div style="border:1px solid var(--border);background:var(--surface);padding:24px;display:grid;gap:12px;align-content:start">
          <p class="mono-label">SYSTEM / PROFILE</p>
          <div style="display:grid;gap:8px;font-size:14px">
            <div style="display:flex;justify-content:space-between;gap:16px"><span class="mono-label">Role</span><span>Design · Code · Ship</span></div>
            <div style="display:flex;justify-content:space-between;gap:16px"><span class="mono-label">Stack</span><span>Astro · Svelte · Go · TS</span></div>
            <div style="display:flex;justify-content:space-between;gap:16px"><span class="mono-label">Location</span><span>Guangzhou, China</span></div>
            <div style="display:flex;justify-content:space-between;gap:16px"><span class="mono-label">Status</span><span style="color:var(--success)">● Available</span></div>
          </div>
          <hr class="hr hr--subtle" />
          <div style="display:flex;gap:12px;flex-wrap:wrap" class="mono-label">
            <a href="https://github.com/dakai" target="_blank" rel="noreferrer" style="color:var(--text-secondary)">GitHub ↗</a>
            <a href="mailto:hello@oudakai.dev" style="color:var(--text-secondary)">hello@oudakai.dev ↗</a>
          </div>
        </div>
      </div>
    </div>
  </section>
  <style>
    @media (max-width: 760px) { .about-grid { grid-template-columns:1fr !important; } }
  </style>
</BaseLayout>
