---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 — DAKAI" description="Page not found.">
  <section class="section">
    <div class="container">
      <p class="mono-label">ERROR / 404 <span style="color:var(--accent)">● NOT FOUND</span></p>
      <h1 style="font-size:var(--text-h1);line-height:1;letter-spacing:-.035em;margin-top:12px">This page<br />doesn't exist.</h1>
      <p style="color:var(--text-secondary);margin-top:16px;max-width:36ch">The link may be old, or the page moved. Everything that does exist is one click away.</p>
      <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:28px">
        <a href="/" class="btn btn--primary">Back home →</a>
        <a href="/projects" class="btn btn--secondary">View projects</a>
      </div>
    </div>
  </section>
  <style>
    .btn { display:inline-flex;align-items:center;height:48px;padding:0 20px;border-radius:999px;font-size:14px;font-weight:500;border:1px solid transparent;transition:all 200ms cubic-bezier(.16,1,.3,1); }
    .btn--primary { background:var(--text-primary); color:var(--ink); }
    .btn--primary:hover { background:var(--accent); border-color:var(--accent); }
    .btn--secondary { background:transparent; color:var(--text-primary); border-color:#383838; }
    .btn--secondary:hover { border-color:var(--accent); color:var(--accent); }
  </style>
</BaseLayout>
