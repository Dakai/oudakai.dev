---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import type { ComponentProps } from "astro/types";

// Content slot — add projects here.
const projects: ComponentProps<typeof ProjectCard>[] = [];
---

<BaseLayout title="Projects — DAKAI">
  <section class="section">
    <div class="container">
      <SectionHeading
        index="01"
        label="PROJECTS"
        title="Things I've built for clients and for myself."
        subtitle="Each project is documented with process, decisions and trade-offs — not just the outcome."
      />
      {
        projects.length > 0 ? (
          <div class="proj-grid">{projects.map((p) => <ProjectCard {...p} />)}</div>
        ) : (
          <EmptyState label="No projects published yet." />
        )
      }
    </div>
  </section>
  <style>
    .proj-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--gap);
    }
    @media (max-width: 900px) {
      .proj-grid {
        grid-template-columns: 1fr 1fr;
      }
    }
    @media (max-width: 560px) {
      .proj-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
