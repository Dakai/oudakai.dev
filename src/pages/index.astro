---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogRow from "../components/BlogRow.astro";
import ToolCard from "../components/ToolCard.astro";
import EmptyState from "../components/EmptyState.astro";
import type { ComponentProps } from "astro/types";

// Content slots — fill these; the sections render their empty state until then.
const projects: ComponentProps<typeof ProjectCard>[] = [];
const posts: ComponentProps<typeof BlogRow>[] = [];
const tools: ComponentProps<typeof ToolCard>[] = [];
---

<BaseLayout title="DAKAI — Independent Digital Studio">
  <Hero />

  <!-- 01 / PROJECTS -->
  <section class="section">
    <div class="container">
      <SectionHeading
        index="01"
        label="SELECTED PROJECTS"
        title="Things I've built for clients and for myself."
        subtitle="Each project is documented with process, decisions and trade-offs — not just the outcome."
      />
      {
        projects.length > 0 ? (
          <div class="proj-grid">{projects.map((p) => <ProjectCard {...p} />)}</div>
        ) : (
          <EmptyState label="No projects published yet." />
        )
      }
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- 02 / WRITING -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        index="02"
        label="WRITING"
        title="Notes on building."
        subtitle="Longer form writing on design, code and running a small studio."
      />
      {
        posts.length > 0 ? (
          <div>{posts.map((p) => <BlogRow {...p} />)}</div>
        ) : (
          <EmptyState label="No articles published yet." />
        )
      }
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- 03 / TOOLS -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        index="03"
        label="TOOLS"
        title="Small useful things."
        subtitle="Focused single-purpose tools. No dashboards, no accounts."
      />
      {
        tools.length > 0 ? (
          <div class="tools-grid">{tools.map((t) => <ToolCard {...t} />)}</div>
        ) : (
          <EmptyState label="No tools published yet." />
        )
      }
    </div>
  </section>

  <!-- signal strip -->
  <div class="signal-strip mono-label">
    <div class="container signal-strip__inner">
      <span>DARK · TYPE · GRID · MONO · SPACE · SIGNAL · MOTION</span>
      <span>INK #080808 — SURFACE #111111 — SIGNAL #4F7CFF</span>
    </div>
  </div>
</BaseLayout>

<style>
  .proj-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }
  .tools-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }

  .signal-strip {
    border-block: 1px solid var(--border-subtle);
    padding-block: 12px;
    font-size: 10px;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }
  .signal-strip__inner {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  @media (max-width: 900px) {
    .proj-grid,
    .tools-grid {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 560px) {
    .proj-grid,
    .tools-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
