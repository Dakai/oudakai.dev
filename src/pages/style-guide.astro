---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import BlogRow from "../components/BlogRow.astro";
import ToolCard from "../components/ToolCard.astro";
import SectionHeading from "../components/SectionHeading.astro";

// Every swatch below reads its value straight out of the token sheet, so this
// page cannot drift from src/styles/global.css.
const themes = [
  { id: "dark", note: "default — no attribute needed" },
  { id: "light", note: '<html data-theme="light">' },
];

const groups = [
  {
    label: "SURFACES",
    hint: "elevation ladder",
    items: [
      { token: "--bg", role: "canvas" },
      { token: "--surface-sunken", role: "inset well" },
      { token: "--surface", role: "card" },
      { token: "--surface-raised", role: "overlay" },
    ],
    kind: "fill",
  },
  {
    label: "TEXT",
    hint: "4.5:1 on every surface above",
    items: [
      { token: "--text-primary", role: "headings, body" },
      { token: "--text-secondary", role: "supporting copy" },
      { token: "--text-muted", role: "metadata, dates" },
      { token: "--text-disabled", role: "disabled only" },
    ],
    kind: "text",
  },
  {
    label: "BORDERS",
    hint: "1px alpha hairlines",
    items: [
      { token: "--border-subtle", role: "separator" },
      { token: "--border", role: "container edge" },
      { token: "--border-hover", role: "hovered edge" },
      { token: "--border-strong", role: "outline button" },
    ],
    kind: "border",
  },
  {
    label: "ACCENT",
    hint: "brand presence",
    items: [
      { token: "--accent", role: "identity, links" },
      { token: "--accent-hover", role: "hovered label" },
      { token: "--accent-subtle", role: "tinted fill" },
    ],
    kind: "fill",
  },
  {
    label: "STATUS",
    hint: "never brand-coloured",
    items: [
      { token: "--success", role: "available, ok" },
      { token: "--warning", role: "caution" },
      { token: "--danger", role: "error, destructive" },
      { token: "--info", role: "informational" },
    ],
    kind: "text",
  },
];
---

<BaseLayout title="Style Guide — DAKAI">
  <div class="container" style="padding-block:48px 24px">
    <p class="mono-label">00 / STYLE GUIDE — VISUAL SOURCE OF TRUTH</p>
    <h1 style="font-size:var(--text-display);line-height:.95;letter-spacing:-.045em;margin-top:12px">Dark<br/>Type<br/>Grid.</h1>
    <p style="color:var(--text-secondary);margin-top:16px;max-width:40ch">This page is the reference for every future change. If a component is not here, it does not exist yet.</p>
  </div>

  <hr class="hr" />

  <!-- colors -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading
        index="01"
        label="COLOR"
        title="Roles, not hex."
        subtitle="Components reference tokens only — a hex literal inside a component is a bug. Dark is the default identity; light is opt-in."
      />

      <div class="themes">
        {
          themes.map((theme) => (
            <div class="theme" data-theme={theme.id}>
              <div class="theme__head">
                <span class="mono-label">{theme.id.toUpperCase()}</span>
                <span class="mono-label theme__hint">{theme.note}</span>
              </div>

              {groups.map((group) => (
                <div class="group">
                  <div class="group__head">
                    <span class="mono-label">{group.label}</span>
                    <span class="group__hint">{group.hint}</span>
                  </div>
                  <div class="group__rows">
                    {group.items.map((item) => (
                      <div class="sw">
                        {group.kind === "fill" && (
                          <i class="sw__chip" style={`background:var(${item.token})`} />
                        )}
                        {group.kind === "border" && (
                          <i
                            class="sw__chip"
                            style={`background:var(--surface);border-color:var(${item.token})`}
                          />
                        )}
                        {group.kind === "text" && (
                          <i
                            class="sw__chip sw__chip--glyph"
                            style={`background:var(--surface);color:var(${item.token})`}
                          >
                            Aa
                          </i>
                        )}
                        <span class="sw__meta">
                          <span class="mono-label">{item.token}</span>
                          <span class="sw__role">{item.role}</span>
                        </span>
                      </div>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          ))
        }
      </div>

      <p class="mono-label" style="margin-top:24px;color:var(--text-muted)">Ratio — Surfaces 82% · Text 15% · Accent 3%. Elevation is surface + border in dark, surface + shadow in light. Text clears 4.5:1 on every surface in the ladder; --text-disabled is the one exemption.</p>
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- typography -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading index="02" label="TYPOGRAPHY" title="Geist · Geist Mono" subtitle="Headings 500 · Body 400 · Mono for metadata, numbers, labels." />
      <div class="type-samples">
        <div class="type-row"><span class="mono-label">Display XL — 96 / 0.92 / -0.055em / 500</span><p style="font-size:var(--text-display-xl);line-height:.92;letter-spacing:-.055em;font-weight:500">BUILDING DIGITAL THINGS.</p></div>
        <div class="type-row"><span class="mono-label">Display — 72 / 0.95 / -0.045em / 500</span><p style="font-size:var(--text-display);line-height:.95;letter-spacing:-.045em;font-weight:500">A better way to move goods.</p></div>
        <div class="type-row"><span class="mono-label">H1 — 56 / 1 / -0.035em</span><p style="font-size:var(--text-h1);line-height:1;letter-spacing:-.035em;font-weight:500">Project title goes here</p></div>
        <div class="type-row"><span class="mono-label">H2 — 40 / 1.05 / -0.025em</span><p style="font-size:var(--text-h2);line-height:1.05;letter-spacing:-.025em;font-weight:500">Section heading</p></div>
        <div class="type-row"><span class="mono-label">Body Large — 20 / 1.5</span><p style="font-size:var(--text-body-lg);line-height:1.5;color:var(--text-secondary)">Websites, tools and experiments. A quiet technical editorial voice.</p></div>
        <div class="type-row"><span class="mono-label">Body — 16 / 1.6</span><p style="font-size:var(--text-body);line-height:1.6;color:var(--text-secondary)">Body copy at 16px. Generous whitespace, no decoration without purpose.</p></div>
        <div class="type-row"><span class="mono-label">Mono — 12 / 1.4 / 0.02em</span><p style="font-family:var(--font-mono);font-size:var(--text-mono);line-height:1.4;letter-spacing:.02em;color:var(--text-muted)">01 / PROJECT — 2026.09.10 — ASTRO · SVELTE · TYPESCRIPT</p></div>
      </div>

      <div class="hierarchy-demo" style="margin-top:40px;border:1px solid var(--border);padding:32px;background:var(--surface)">
        <p class="mono-label">01 / PROJECT</p>
        <p style="font-size:clamp(32px,6vw,56px);font-weight:500;letter-spacing:-.035em;line-height:.95;margin-top:12px">A BETTER WAY<br/>TO MOVE GOODS.</p>
        <p style="color:var(--text-secondary);margin-top:12px">Web design · Development · E-commerce</p>
      </div>
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- buttons -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading index="03" label="BUTTONS" title="Pill primary. Outline secondary." />
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a href="#" class="btn btn--primary">Discuss a project →</a>
        <a href="#" class="btn btn--secondary">Read blog</a>
        <a href="#" class="btn btn--secondary" aria-disabled="true">Disabled</a>
      </div>
      <p class="mono-label" style="margin-top:12px;color:var(--text-muted)">Declared once in global.css — never re-declare .btn in a component. Primary: fill --inverse-bg → hover --accent. Secondary: transparent / --border-strong → hover --accent-hover. Height 48px · Radius 999px</p>
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- grid -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading index="04" label="GRID" title="12-col desktop · 4-col mobile" subtitle="Max 1440px · Gutter 32px (20px mobile) · Gap 16px (12px mobile)." />
      <div class="grid-12" style="margin-top:8px">
        {Array.from({ length: 12 }).map(() => <div style="height:48px;background:var(--surface);border:1px solid var(--border)"></div>)}
      </div>
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- cards -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading index="05" label="CARDS" title="--surface · --border · hover --border-hover" subtitle="No gradient, no glass. Image bed is --surface-sunken. Elevation is the shadow token — free in dark, real in light." />
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px" class="sg-cards">
        <ProjectCard index="01" category="CLIENT WORK" title="A better way to move goods" description="E-commerce & brand site for a modern logistics group." stack={["ASTRO","SVELTE","TYPESCRIPT"]} href="#" />
        <ProjectCard index="02" category="CLIENT WORK" title="Second project name" description="Short description of the project." stack={["ASTRO","TYPESCRIPT"]} href="#" />
        <ProjectCard index="03" category="EXPERIMENT" title="Third project name" description="Short description of the project." stack={["ASTRO","MDX"]} href="#" />
      </div>
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- blog rows -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading index="06" label="BLOG ROWS" title="Editorial list, not cards." subtitle="Border-top hairline · Mono date + category · 17px title. Hover: --surface-hover wash, title → --accent-hover." />
      <div>
        <BlogRow date="09.10.26" category="WEB DEVELOPMENT" title="Why I moved my personal website from WordPress to Astro" readingTime="8 min" href="#" />
        <BlogRow date="08.28.26" category="DESIGN SYSTEM" title="Second article title" readingTime="6 min" href="#" />
        <BlogRow date="08.14.26" category="TOOLING" title="Third article title" readingTime="4 min" href="#" />
      </div>
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- tools -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading index="07" label="TOOLS" title="Mono · index · status dot" subtitle="Technical but not a dashboard. One purpose per card." />
      <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:16px" class="sg-tools">
        <ToolCard index="01" name="Image Compressor" description="Reduce image size without destroying quality." href="#" />
        <ToolCard index="02" name="JSON Formatter" description="Format, validate and inspect JSON." href="#" />
        <ToolCard index="03" name="Third tool" description="Short description of the tool." href="#" />
      </div>
    </div>
  </section>

  <hr class="hr hr--subtle" />

  <!-- experimental -->
  <section class="section section--tight">
    <div class="container">
      <SectionHeading index="08" label="EXPERIMENTAL" title="≤ 5–10% of the page." subtitle="Grid dots · coordinates · system labels · tiny ● indicator in --accent. Opacity low, never dominant." />
      <div style="display:flex;gap:24px;flex-wrap:wrap" class="mono-label">
        <span>SYSTEM / 001</span><span>BUILD / 2026</span><span>STATUS / ACTIVE</span><span style="color:var(--success)">● ONLINE</span>
      </div>
      <div style="margin-top:16px;height:80px;border:1px solid var(--border);background:radial-gradient(circle, var(--text-primary) 1px, transparent 1px);background-size:20px 20px;opacity:.06"></div>
    </div>
  </section>

  <hr class="hr" />
  <div class="container" style="padding-block:24px">
    <p class="mono-label" style="color:var(--text-muted)">V2 — Dark first, light opt-in via &lt;html data-theme="light"&gt; · Spacing 4px base (4 8 12 16 24 32 48 64 80 96 128 160 192) · Motion 200–700ms ease-out · Radius sharp (cards 0–4px, buttons 999px)</p>
  </div>
</BaseLayout>

<style>
  .themes { display:grid; gap:16px; margin-top:8px; }
  .theme {
    background:var(--bg);
    color:var(--text-primary);
    border:1px solid var(--border);
    box-shadow:var(--shadow-card);
    padding:24px;
    display:grid;
    gap:20px;
  }
  .theme__head {
    display:flex; justify-content:space-between; align-items:baseline; gap:16px;
    border-bottom:1px solid var(--border-subtle); padding-bottom:12px;
  }
  .theme__hint { color:var(--text-muted); text-transform:none; }

  .group { display:grid; gap:10px; }
  .group__head { display:flex; justify-content:space-between; align-items:baseline; gap:12px; }
  .group__hint { font-size:12px; color:var(--text-muted); }
  .group__rows { display:grid; grid-template-columns:repeat(4,1fr); gap:8px; }

  .sw { display:grid; gap:8px; }
  .sw__chip {
    display:block; height:56px; border:1px solid var(--border);
  }
  .sw__chip--glyph {
    display:grid; place-items:center; font-size:18px; font-weight:500;
  }
  .sw__meta { display:grid; gap:2px; }
  .sw__role { font-size:12px; line-height:1.3; color:var(--text-muted); }

  .type-samples { display:grid; gap:28px; margin-top:8px; }
  .type-row { display:grid; gap:6px; padding-bottom:20px; border-bottom:1px solid var(--border-subtle); }
  .type-row:last-child { border:0; }
  @media (max-width: 700px) {
    .group__rows { grid-template-columns:repeat(2,1fr); }
    .sg-cards, .sg-tools { grid-template-columns:1fr !important; }
  }
</style>
