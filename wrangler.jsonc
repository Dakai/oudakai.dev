{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "oudakai-dev",
  "compatibility_date": "2026-09-11",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "oudakai.dev",
      "custom_domain": true
    },
    {
      "pattern": "www.oudakai.dev",
      "custom_domain": true
    }
  ]
}
